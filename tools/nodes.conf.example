# Copy to tools/nodes.conf (not committed) and adjust.
# The SSH key is $VMS_SSH_KEY, default ~/.ssh/vms_ed25519.
# Use the same work directory as the sibling ports: the vms-zlib and vms-pcre2
# install trees are found there (<workdir>.ZLIB-1_3_2.INSTALL_<arch>] etc.).
# name  arch    host          port  user      vms_workdir                   sftp_workdir
ia64    IA64    <ia64-host>   22    username  DISK$USER:[USERNAME.VMS_GREP]   vms_grep
x86     X86_64  <x86-host>    22    username  DISK$USER:[USERNAME.VMS_GREP]   vms_grep
